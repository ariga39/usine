{
  "name": "usine",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --filter '@usine/cli...' build",
    "check:links": "node scripts/check-markdown-links.mjs",
    "db:generate": "corepack pnpm --filter @usine/task-authority db:generate",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "test": "vp run --filter '@usine/cli...' build && vp test && vp run --filter './packages/*' --filter './apps/*' test",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@usine/candidate-workspace": "workspace:*",
    "@usine/coding-session": "workspace:*",
    "@usine/delivery-run": "workspace:*",
    "@usine/forge-delivery": "workspace:*",
    "@usine/quality-gate": "workspace:*",
    "@usine/runtime": "workspace:*",
    "@usine/task-authority": "workspace:*",
    "effect": "4.0.0-rc.110",
    "execa": "latest",
    "typescript": "latest",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.22.0"
}
