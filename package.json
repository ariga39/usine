{
  "name": "usine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "check:links": "node scripts/check-markdown-links.mjs",
    "db:generate": "corepack pnpm --filter @usine/runtime db:generate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && corepack pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "latest",
    "execa": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.22.0"
}
