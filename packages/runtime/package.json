{
  "name": "@usine/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.mjs"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "import": "./dist/contract.mjs"
    },
    "./task-authority": {
      "types": "./src/task-authority.ts",
      "import": "./dist/task-authority.mjs"
    },
    "./candidate-workspace": {
      "types": "./src/candidate-workspace.ts",
      "import": "./dist/candidate-workspace.mjs"
    },
    "./coding-session": {
      "types": "./src/coding-session.ts",
      "import": "./dist/coding-session.mjs"
    },
    "./quality-gate": {
      "types": "./src/quality-gate.ts",
      "import": "./dist/quality-gate.mjs"
    },
    "./forge-delivery": {
      "types": "./src/forge-delivery.ts",
      "import": "./dist/forge-delivery.mjs"
    },
    "./delivery-run": {
      "types": "./src/delivery-run.ts",
      "import": "./dist/delivery-run.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.146.0",
    "drizzle-orm": "latest",
    "execa": "latest",
    "octokit": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "tsdown": "latest",
    "typescript": "latest"
  }
}
