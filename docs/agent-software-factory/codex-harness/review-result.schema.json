{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_sha",
    "spec_verdict",
    "design_verdict",
    "summary",
    "findings"
  ],
  "properties": {
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec_verdict": {
      "enum": ["approved", "changes_requested", "inconclusive"]
    },
    "design_verdict": {
      "enum": ["approved", "changes_requested", "inconclusive", "not_required"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "summary", "evidence", "impact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["spec", "design"] },
          "severity": { "enum": ["blocking", "non_blocking"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
